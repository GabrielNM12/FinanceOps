DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Comentarios sem acento de proposito: arquivos .env passam por editores e
# terminais do Windows com codificacoes diferentes, e acento vira mojibake.
# ---------------------------------------------------------------------------

# --- Idioma / Language ----------------------------------------------------
# Idioma da instancia, definido no BUILD. Ausente, vazio ou qualquer valor
# diferente de "en" mantem o portugues (pt-BR), que e o padrao. Somente "en"
# liga o ingles: interface, caminhos das URLs (/impostos -> /taxes, etc.),
# e-mails de acesso e formato de numero (R$ 1,234.56). Moeda continua BRL.
# Precisa do prefixo NEXT_PUBLIC_ para chegar ao codigo do navegador.
# NEXT_PUBLIC_APP_LOCALE="en"

# --- Acesso ----------------------------------------------------------------
# Assina o cookie de sessao. Gere com: openssl rand -base64 32
# Obrigatorio: sem ele o login nao funciona.
AUTH_SECRET=""

# Entrada de emergencia enquanto nenhum socio tem e-mail cadastrado.
# Remova assim que os enderecos estiverem em Configuracoes -> Socios.
AUTH_BOOTSTRAP_EMAIL=""

# URL publica, usada para montar o link do e-mail. Se vazio, e deduzida dos
# cabecalhos da requisicao - o que ja cobre o desenvolvimento e o proxy da VPS.
# APP_URL="https://financeops.korvantis.com"

# --- Envio de e-mail (SMTP) ------------------------------------------------
# ATENCAO: variaveis de ambiente sao lidas quando o processo sobe. Se voce
# preencher isto com o servidor rodando, REINICIE - senao o link vai para o
# console e nenhum e-mail e enviado, sem erro nenhum.
#
# Gmail / Google Workspace: use SENHA DE APP (16 caracteres, sem espacos),
# nao a senha da conta. Exige 2FA ativado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FinanceOps <financeops@korvantis.com>"

# Confira tudo isto com:  npm run auth:diagnostico

# --- Modo demonstracao -----------------------------------------------------
# PERIGOSO. Liga o FinanceOps SEM LOGIN: qualquer pessoa com a URL le, lanca,
# edita e apaga. Serve para mostrar a ferramenta com dados ficticios.
#
# Desligado por padrao. So "1", "true", "sim", "yes" ou "on" ligam - qualquer
# outro valor (inclusive vazio) mantem o login exigido.
#
# Com ele ligado a interface mostra uma tarja amarela fixa em todas as telas.
# NUNCA ligue com dados reais dentro.
# MODO_DEMO="1"

# --- Integracao ------------------------------------------------------------
# Token da API /api/v1/*. Vazio = modo local aberto. Ver INTEGRACAO.md.
# API_TOKEN=""

# --- Deploy em VPS ---------------------------------------------------------
# Usado pelo docker-compose. Ignore em desenvolvimento local.
# DOMINIO="financeops.korvantis.io"
# EMAIL_ADMIN="gabriel@korvantis.io"
#
# Se a maquina JA TEM um proxy servindo outros sites, o Caddy proprio do
# compose nao consegue subir (porta 80 ocupada). Nesse caso use o arquivo
# alternativo, que pluga o app no proxy existente:
# COMPOSE_FILE="docker-compose.proxy.yml"
# REDE_PROXY="stack_default"

# --- Backup ----------------------------------------------------------------
# Onde o `npm run db:backup` grava. Aponte para a pasta do Drive.
# BACKUP_DIR="C:/Users/Gabriel/Google Drive/FinanceOps"
